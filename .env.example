# Copy this file to .env for local use and fill in real values.
# NEVER put real passwords or connection strings in this file.

# Your Neon POOLED connection string
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# The shared family password
APP_PASSWORD=change-me

# A long random string used to sign logins
SESSION_SECRET=change-me-to-a-long-random-string

# Set to production on Render
NODE_ENV=development

# How many days a login stays valid
SESSION_DAYS=30
